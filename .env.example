# Copy this file to ".env" and fill in your own local values.
# Never commit the real .env file. Placeholders only in this template.

# Flask session signing key. Generate a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Flask environment: development | production
FLASK_ENV=development
FLASK_DEBUG=1

# --- MySQL connection (created manually from database/schema.sql) --------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=retail_app
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=txn_rules_db

# Set to true only when the app is served over HTTPS in production.
SESSION_COOKIE_SECURE=false

# Upload limit for dataset files, in megabytes.
MAX_UPLOAD_MB=64
